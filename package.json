{
  "name": "bowin-tournament-os",
  "version": "1.0.0",
  "description": "Bowin Tournament OS for registration, brackets, scorekeeping, and live displays",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "prisma generate && vite build && tsc -p tsconfig.server.json && tsc -p tsconfig.demo.json",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node server.js",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium firefox webkit",
    "qa:smoke": "node scripts/production-smoke.mjs",
    "seed": "tsx prisma/seed.ts",
    "demo:reset": "tsx prisma/demo-seed.ts",
    "demo:reset:production": "node dist-demo/prisma/demo-seed.js",
    "build:full": "prisma generate && prisma db push && vite build && tsc -p tsconfig.server.json",
    "bundle:analyze": "node scripts/analyze-bundle.mjs analyze",
    "bundle:check": "node scripts/analyze-bundle.mjs check",
    "bundle:baseline": "node scripts/analyze-bundle.mjs baseline"
  },
  "keywords": [
    "bowin",
    "taekwondo",
    "martial-arts",
    "tournament",
    "brackets",
    "scorekeeping"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sentry/node": "^10.73.0",
    "@sentry/react": "^10.73.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.0",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.5.4",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.22.1",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.6.1",
    "file-type": "^19.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.577.0",
    "pg": "^8.22.0",
    "postcss": "^8.5.23",
    "posthog-js": "^1.429.5",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "7.18.2",
    "stripe": "22.4.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@playwright/test": "^1.62.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^9.2.4",
    "eslint": "^10.8.0",
    "jsdom": "^27.4.0",
    "prisma": "^7.9.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.0.18"
  }
}
