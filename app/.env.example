# Server Configuration
PORT=3001
NODE_ENV=development

# Security - REQUIRED for production
# Generate a secure random string (at least 32 characters)
# Example: openssl rand -base64 32
JWT_SECRET=your-secure-random-string-change-in-production

# CORS - Comma-separated list of allowed origins (for production)
# Example: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173

# Database (SQLite by default - path relative to app/)
# DATABASE_URL="file:./prisma/dev.db"

# Email / SMTP (optional - enables invitation emails and registration confirmations)
# Supports any SMTP provider (Mailgun, SendGrid, Postmark, Gmail SMTP, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@yourdomain.com
# Optional display name for From field
SMTP_FROM_NAME=Tournament Manager

# Public base URL (used for magic links and invitation emails)
# Should match the frontend URL in production
APP_URL=http://localhost:5173
