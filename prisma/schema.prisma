generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// Persistent competitor registry
model Competitor {
  id           String   @id @default(uuid())
  firstName    String
  lastName     String
  gender       String // M or F
  dateOfBirth  DateTime
  belt         String // White, Yellow, Green, Blue, Red, Black
  beltStripe   String? // e.g., "Single Green Stripe"
  danRank      Int? // 1-6 for Black Belts, null for colored belts
  heightInches Float?
  weightLbs    Float?
  schoolDojang String?
  specialNeeds String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Experience tracking for fair matching
  beltPromotionDate DateTime? // When they earned current belt
  yearsTraining     Float? // Total years of martial arts training
  region            String? // Geographic region for regional diversity
  reachInches       Float? // Arm reach for sparring matching

  // Soft-delete: managers can accidentally delete a kid/division. We
  // keep the row in the DB for 7 days with deletedAt set, then a
  // cron could purge. The list endpoint filters these out by default;
  // ?trash=true shows them; POST /:id/restore un-sets deletedAt.
  deletedAt DateTime?

  registrations     Registration[]
  competitorHistory CompetitorHistory[]
  ratings           CompetitorRating[]

  @@index([lastName, firstName])
  @@index([schoolDojang])
  @@index([region])
  // Closes P13: every list query filters on deletedAt=null; without
  // this index the planner may skip the (lastName, firstName)
  // index and scan. Same pattern as Incident.deletedAt.
  @@index([deletedAt])
}

// Tournament instances
model Tournament {
  id        String   @id @default(uuid())
  name      String
  date      DateTime
  location  String?
  status    String   @default("draft") // draft, registration, brackets, in_progress, completed
  settings  String? // JSON string for tournament-specific settings
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId   String?
  sportProfileId   String?
  sportProfileSlug String? @default("taekwondo")

  // Soft-delete: see Competitor.deletedAt comment
  deletedAt DateTime?

  // Public share token for the unauthenticated scoreboard. Directors
  // see this in the Tournament Settings page; it goes into the URL for
  // the public scoreboard link. Without a matching token the route
  // returns 404 — a brute-force guess of valid UUIDs is impractical.
  // Optional (NULL) means the public scoreboard link is disabled for
  // this tournament. Rotated from the UI to revoke the old link.
  publicSlug String? @unique

  registrations       Registration[]
  divisions           Division[]
  weightClasses       WeightClass[]
  userAccess          UserTournamentAccess[]
  rules               TournamentRule[]
  incidents           Incident[]
  competitorHistories CompetitorHistory[]
  matchupHistories    MatchupHistory[]
  organization        Organization?          @relation(fields: [organizationId], references: [id])
  sportProfile        SportProfile?          @relation(fields: [sportProfileId], references: [id])

  // Closes P13: every list query filters on deletedAt; without
  // an index the planner may scan. The tournaments list also
  // filters on status; the publicSlug is already @unique.
  @@index([deletedAt])
  @@index([status])
}

// Competitor-Tournament registration link
model Registration {
  id                   String    @id @default(uuid())
  tournamentId         String
  competitorId         String
  patterns             Boolean   @default(false)
  sparring             Boolean   @default(false)
  weightAtRegistration Float? // Weight at time of registration
  ageAtTournament      Int? // Calculated age at tournament date
  checkedIn            Boolean   @default(false)
  checkInTime          DateTime?
  checkInWeight        Float? // Weight at check-in (for verification)
  parentName           String?
  parentEmail          String?
  parentPhone          String?
  managementTokenHash     String?   @unique
  // When the current management token stops being valid. Null = never
  // expires (legacy rows; only the hash-based capability matters there).
  managementTokenExpiresAt DateTime?
  // When a director or the parent themselves revoked the current token.
  // Null = active. The token's hash remains in the row for audit but is
  // no longer accepted.
  managementTokenRevokedAt DateTime?
  // Last successful verification (read/update/withdraw) of the token.
  // Used to surface "last activity" to directors and to drive the
  // lastUsedAt audit clock. Not used as an authentication signal.
  managementTokenLastUsedAt DateTime?
  consentVersion       String?
  consentAcceptedAt    DateTime?
  privacyAccepted      Boolean   @default(false)
  rulesAccepted        Boolean   @default(false)
  guardianAttested     Boolean   @default(false)
  createdAt            DateTime  @default(now())

  // Enhanced attributes for fair matching
  heightAtRegistration Float? // Height at registration time
  reachAtRegistration  Float? // Reach at registration time
  experienceScore      Float? // Calculated from history
  skillEstimate        Float? // Estimated skill level
  competeWithOlder     Boolean @default(false) // Competitor/parent opt-in to compete in older age band
  specialNeeds         String? // Per-registration notes (separate from competitor-level field)
  manualDivisionId     String? // Manager override — pin to a specific Division ID
  seeding              Int? // Manual seeding 1..N (null = auto-seed by rating)

  tournament  Tournament           @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  competitor  Competitor           @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  assignments DivisionAssignment[]
  matches1    Match[]              @relation("Competitor1")
  matches2    Match[]              @relation("Competitor2")
  matchWins   Match[]              @relation("Winner")

  @@unique([tournamentId, competitorId])
  @@index([tournamentId])
  @@index([competitorId])
  // Closes P13: day-of panel queries filter on checkedIn.
  @@index([tournamentId, checkedIn])
}

// Auto-generated or manually created divisions/categories
model Division {
  id             String  @id @default(uuid())
  tournamentId   String
  name           String // e.g., "10-11 CB All Green Belts Males Sparring Heavy"
  beltLevel      String // BB or CB
  gender         String // M or F
  eventType      String // patterns or sparring
  ageMin         Int
  ageMax         Int
  beltColors     String? // JSON array: ["White", "Yellow"]
  danMin         Int?
  danMax         Int?
  weightClass    String? // Feather, Light, Middle, Heavy
  divisionNumber Int     @default(1) // DIV1, DIV2, DIV3

  // Soft-delete: see Competitor.deletedAt comment
  deletedAt      DateTime?
  isSpecialNeeds Boolean   @default(false)
  displayOrder   Int?
  createdAt      DateTime  @default(now())

  // Fairness metadata
  bracketDifficulty Float? // Calculated bracket difficulty score
  matchupQuality    Float? // Overall matchup fairness score
  avgSkillRating    Float? // Average skill rating of competitors

  tournament  Tournament           @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  assignments DivisionAssignment[]
  bracket     Bracket?

  @@index([tournamentId])
  @@index([tournamentId, eventType])
  @@index([tournamentId, gender, eventType])
  // Closes P13: every list query filters on deletedAt.
  @@index([deletedAt])
}

// Competitor-Division assignment
model DivisionAssignment {
  id             String   @id @default(uuid())
  divisionId     String
  registrationId String
  seedPosition   Int? // Bracket seeding
  manualOverride Boolean  @default(false) // True if manually placed
  createdAt      DateTime @default(now())

  division     Division     @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([divisionId, registrationId])
  @@index([divisionId])
  @@index([registrationId])
}

// Bracket structure for a division
model Bracket {
  id         String   @id @default(uuid())
  divisionId String   @unique
  structure  String // JSON bracket tree structure
  format     String   @default("double_elim") // double_elim, single_elim, round_robin, pool_play
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  division Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  matches  Match[]
}

// Individual matches
model Match {
  id            String    @id @default(uuid())
  bracketId     String
  roundNumber   Int
  matchNumber   Int
  bracketType   String // winners, losers, finals, pool
  competitor1Id String?
  competitor2Id String?
  winnerId      String?
  score1        String?
  score2        String?
  status        String    @default("pending") // pending, ready, in_progress, completed, bye
  scheduledTime DateTime?
  ringNumber    Int?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bracket     Bracket       @relation(fields: [bracketId], references: [id], onDelete: Cascade)
  competitor1 Registration? @relation("Competitor1", fields: [competitor1Id], references: [id], onDelete: SetNull)
  competitor2 Registration? @relation("Competitor2", fields: [competitor2Id], references: [id], onDelete: SetNull)
  winner      Registration? @relation("Winner", fields: [winnerId], references: [id], onDelete: SetNull)

  @@index([bracketId])
  @@index([status])
  @@index([winnerId])
  // Closes P13: the match-advancement path looks up "the next
  // winners match" via bracketId+roundNumber+bracketType. The
  // previous indexes on bracketId and status didn't cover this
  // combined lookup, so a 100+ match bracket hit a full scan per
  // advancement. Same for competitor1Id / competitor2Id, used by
  // the public scoreboard to enumerate a registration's matches.
  @@index([bracketId, roundNumber, bracketType])
  @@index([competitor1Id])
  @@index([competitor2Id])
}

// Configurable weight classes per tournament
model WeightClass {
  id           String  @id @default(uuid())
  tournamentId String
  name         String // Feather, Light, Middle, Heavy
  gender       String?
  ageMin       Int?
  ageMax       Int?
  weightMinLbs Float?
  weightMaxLbs Float?
  displayOrder Int?

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
}

// User authentication
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String?
  firstName    String
  lastName     String
  role         String    @default("viewer") // admin, director, scorekeeper, viewer
  isActive     Boolean   @default(true)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // JWT tokenVersion: bumped on logout / role change / isActive flip
  // to invalidate every outstanding token for this user at once.
  // Without this, a JWT in flight remains valid until its 7-day TTL
  // expires regardless of who owns it. Default 0 keeps the column
  // populated for existing rows after `db:push`.
  tokenVersion Int @default(0)

  // Tournament-specific permissions
  tournamentAccess    UserTournamentAccess[]
  organizationMembers OrganizationMember[]
}

// Magic link / code authentication
model MagicLink {
  id             String    @id @default(uuid())
  email          String
  // Stored as SHA-256 hex of the raw token emailed to the user.
  // Legacy plaintext rows (pre-hash deploy) remain readable via
  // dual-lookup until their 10-minute TTL expires.
  token          String    @unique
  // Stored as SHA-256 hex of the 6-digit code (same dual-read rule).
  code           String
  // Wrong-code attempts against this link. Caps brute-force at
  // MAX_CODE_ATTEMPTS regardless of which replica handles the request.
  failedAttempts Int       @default(0)
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([email])
  @@index([token])
  @@index([email, code])
}

// Tournament-specific user access
model UserTournamentAccess {
  id           String   @id @default(uuid())
  userId       String
  tournamentId String
  role         String // director, scorekeeper, viewer
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([userId, tournamentId])
  @@index([tournamentId])
}

// Track competitor performance across tournaments
model CompetitorHistory {
  id           String   @id @default(uuid())
  competitorId String
  tournamentId String
  divisionId   String
  divisionName String // Stored for historical reference
  eventType    String // patterns or sparring
  placement    Int // 1, 2, 3, etc.
  matchesWon   Int      @default(0)
  matchesLost  Int      @default(0)
  points       Float    @default(0) // Calculated skill points
  createdAt    DateTime @default(now())

  competitor Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  // Closes B8: orphan history rows on hard-delete of Tournament.
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([competitorId])
  @@index([tournamentId])
  @@index([eventType])
  @@index([competitorId, eventType])
}

// Track head-to-head matchup history
model MatchupHistory {
  id            String   @id @default(uuid())
  competitor1Id String // First competitor (alphabetically by ID)
  competitor2Id String // Second competitor
  tournamentId  String
  divisionId    String
  matchId       String
  winnerId      String?
  eventType     String // patterns or sparring
  roundNumber   Int // Which round the matchup occurred
  score         String? // Score if available
  createdAt     DateTime @default(now())

  // Closes B8: orphan history rows on hard-delete of Tournament.
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([competitor1Id, competitor2Id, tournamentId, matchId])
  @@index([competitor1Id])
  @@index([competitor2Id])
  @@index([tournamentId])
}

// Competitor skill ratings (ELO-style)
model CompetitorRating {
  id            String    @id @default(uuid())
  competitorId  String
  eventType     String // patterns or sparring
  rating        Float     @default(1000) // Initial ELO
  peakRating    Float     @default(1000)
  matchesPlayed Int       @default(0)
  lastMatchDate DateTime?
  lastUpdated   DateTime  @default(now())

  competitor Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([competitorId, eventType])
  @@index([competitorId])
  @@index([eventType])
  @@index([rating])
}

// Email invitations
model Invitation {
  id          String   @id @default(uuid())
  email       String
  firstName   String?
  lastName    String?
  role        String   @default("viewer")
  // SHA-256 of the raw invite token (emailed once). Dual-read
  // accepts legacy plaintext until tokenExpiry.
  token       String   @unique
  tokenExpiry DateTime
  invitedBy   String
  status      String   @default("pending") // pending, accepted, expired
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
  @@index([token])
  @@index([status])
}

// Match audit log for undo functionality
model MatchAuditLog {
  id            String   @id @default(uuid())
  matchId       String
  action        String // update, complete, reset
  previousState String // JSON of previous match state
  newState      String // JSON of new match state
  userId        String? // Who made the change
  userEmail     String? // Email for reference
  reason        String? // Optional reason for change
  createdAt     DateTime @default(now())

  @@index([matchId])
  @@index([createdAt])
}

// Audit log for registration management token usage. Records every
// verification attempt (read/update/withdraw/rotate) with the outcome
// (ok/expired/revoked/malformed/not_found), but never the raw token or
// any returned PII. Indexed by registrationId + createdAt for director
// review and for the support/migration path on legacy rows.
model ManagementTokenAuditLog {
  id             String   @id @default(uuid())
  registrationId String? // Null when the token didn't match any row
  action         String // read, update, withdraw, rotate
  outcome        String // ok, expired, revoked, malformed, not_found
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([registrationId])
  @@index([createdAt])
  @@index([action, outcome])
}

// Organization (multi-tenant isolation)
model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  plan      String   @default("free") // free, starter, pro, enterprise
  settings  String? // JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     OrganizationMember[]
  tournaments Tournament[]
  billingSubscription OrganizationBillingSubscription?
  planChanges         OrganizationPlanChange[]

  @@index([slug])
}

model OrganizationBillingSubscription {
  id                     String    @id @default(uuid())
  organizationId         String    @unique
  provider               String    @default("manual")
  providerCustomerId     String?   @unique
  providerSubscriptionId String?   @unique
  status                 String    @default("inactive")
  plan                   String    @default("free")
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([plan])
}

model OrganizationPlanChange {
  id             String   @id @default(uuid())
  organizationId String
  fromPlan       String
  toPlan         String
  source         String   @default("manual")
  reason         String
  changedBy      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model BillingWebhookEvent {
  id              String   @id @default(uuid())
  providerEventId String   @unique
  type            String
  payloadHash     String
  processedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([type])
  @@index([processedAt])
}

// Organization membership
model OrganizationMember {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  role           String   @default("member") // owner, admin, member
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

// Sport configuration profile
model SportProfile {
  id             String   @id @default(uuid())
  name           String // e.g. "Taekwondo", "Karate", "Judo", "MMA", "Boxing"
  slug           String // e.g. "taekwondo", "karate", "judo", "mma", "boxing"
  icon           String? // emoji
  eventTypes     String // JSON array: [{id, name, hasWeightClasses, description}]
  beltConfig     String // JSON: {levels:[{name,abbreviation,rank,color}], hasStripes, hasDanRank, topLevelName}
  scoringConfig  String // JSON: {type:"points"|"decision"|"time", hasPenalties, penaltyName}
  ageGroupConfig String? // JSON array: [{min,max,label}]
  isGlobal       Boolean  @default(true) // false = org-specific
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tournaments Tournament[]

  @@unique([slug])
}

// Medical/incident tracking
model Incident {
  id             String    @id @default(uuid())
  tournamentId   String
  matchId        String?
  registrationId String?
  type           String // injury, disqualification, medical, equipment, conduct
  severity       String // minor, moderate, serious
  description    String
  actionTaken    String? // first_aid, withdrawn, continued, ambulance
  reportedBy     String? // userId of reporter
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  // Soft-delete: keeps incident reports on file (often required
  // for liability / insurance) without surfacing them in active
  // dashboards. Same pattern as Competitor / Tournament / Division.
  deletedAt      DateTime?

  // Closes B8: orphan incident rows on hard-delete of Tournament.
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@index([matchId])
  @@index([registrationId])
  @@index([deletedAt])
}

// Tournament fairness rules (configurable per tournament)
model TournamentRule {
  id           String   @id @default(uuid())
  tournamentId String
  name         String // Human-readable name: "Same-school avoidance"
  description  String? // Why this rule exists
  category     String // "bracket", "division", "weight", "seeding", "custom"
  ruleType     String // "same_school_avoidance", "weight_tolerance", "height_limit", "experience_grouping", "custom_constraint"
  enforcement  String   @default("hard") // "hard" (must comply), "soft" (warning), "info" (log only)
  parameters   String // JSON: rule-specific parameters
  priority     Int      @default(50) // Higher = evaluated first (0-100)
  isActive     Boolean  @default(true)
  source       String   @default("manual") // "manual", "llm_suggested", "system_default"
  createdBy    String? // User ID who created/approved
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@index([tournamentId, category])
  @@index([ruleType])
}

// Snapshot of tournament division state for rollback if a bracket
// regeneration wipes data. Replaces the previous file-based
// BACKUP_DIR/<tournamentId>.json store (closes day-2 follow-up:
// move backupStore to DB table). One row per tournament, overwritten
// in place — there's no audit history, just the "last known good"
// snapshot. The delete-on-success / restore-on-failure lifecycle
// lives in src/server/services/backup-recovery.ts.
model BackupState {
  tournamentId String   @id
  // JSON-encoded TournamentBackup (see backup-recovery.ts). The
  // service layer parses this on read; the schema doesn't try to
  // shape the contents because the structure evolves with the
  // division / assignment models. ~10 KB per row.
  payload      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
