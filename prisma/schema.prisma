generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// Persistent competitor registry
model Competitor {
  id           String   @id @default(uuid())
  firstName    String
  lastName     String
  gender       String // M or F
  dateOfBirth  DateTime
  belt         String // White, Yellow, Green, Blue, Red, Black
  beltStripe   String? // e.g., "Single Green Stripe"
  danRank      Int? // 1-6 for Black Belts, null for colored belts
  heightInches Float?
  weightLbs    Float?
  schoolDojang String?
  specialNeeds String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Experience tracking for fair matching
  beltPromotionDate DateTime? // When they earned current belt
  yearsTraining     Float? // Total years of martial arts training
  region            String? // Geographic region for regional diversity
  reachInches       Float? // Arm reach for sparring matching

  // Soft-delete: managers can accidentally delete a kid/division. We
  // keep the row in the DB for 7 days with deletedAt set, then a
  // cron could purge. The list endpoint filters these out by default;
  // ?trash=true shows them; POST /:id/restore un-sets deletedAt.
  deletedAt DateTime?

  registrations     Registration[]
  competitorHistory CompetitorHistory[]
  ratings           CompetitorRating[]

  // SH-5: Uniqueness invariant on (firstName, lastName, dateOfBirth).
  // Closes the TOCTOU + non-atomic race in /api/public/register
  // and the portal register handler — a same-second double-submit
  // previously created duplicate Competitor rows because the
  // findFirst + create pair wasn't atomic. The unique constraint
  // is the source of truth; route handlers catch P2002 and return
  // 409 with "already registered" so the user gets a clear answer
  // and can refresh to see their existing registration.
  // Note: Competitor is a persistent registry (no tournamentId);
  // case sensitivity follows PostgreSQL defaults, matching the
  // existing case-sensitive `create` payload. The route still
  // does a case-insensitive findFirst to reuse an existing row
  // regardless of how the name was previously stored.
  @@unique([firstName, lastName, dateOfBirth])
  @@index([lastName, firstName])
  @@index([schoolDojang])
  @@index([region])
  // Closes P13: every list query filters on deletedAt=null; without
  // this index the planner may skip the (lastName, firstName)
  // index and scan. Same pattern as Incident.deletedAt.
  @@index([deletedAt])
}

// Tournament
model Tournament {
  id               String    @id @default(uuid())
  name             String
  date             DateTime
  location         String
  status           String    @default("draft") // draft, registration, in_progress, completed
  settings         String? // JSON
  sportProfileId   String?
  sportProfileSlug String    @default("taekwondo")
  organizationId   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime? // Soft-delete: managers can delete a tournament, then restore it.

  // Public scoreboard access control
  publicSlug String? @unique

  // Organizer branding (overrides organization defaults for this event)
  brandName         String?
  brandPrimaryColor String?
  brandLogoUrl      String?

  // Event portal slug for tenant-branded public URLs (/events/:orgSlug/:eventSlug)
  eventSlug         String? // URL-safe slug, unique per org
  portalPublished   Boolean @default(false) // Whether this event is visible on the org's public portal
  portalPublishedAt DateTime? // When the event was first published

  // Public scoreboard display settings (P1-12)
  publicScoreboardRefreshMs Int? @default(10000) // Auto-refresh interval in milliseconds (3000-60000 range)

  // Capacity limits and waitlist (P2-1, #191)
  maxCapacity Int? // Maximum total registrations (null = unlimited)
  waitlistEnabled Boolean @default(false) // Whether to enable waitlist when at capacity

  registrations       Registration[]
  divisions           Division[]
  weightClasses       WeightClass[]
  userAccess          UserTournamentAccess[]
  rules               TournamentRule[]
  incidents           Incident[]
  competitorHistories CompetitorHistory[]
  matchupHistories    MatchupHistory[]
  publicDisplayHeartbeat PublicDisplayHeartbeat?
  operationAudits       TournamentOperationAudit[]
  recommendations       Recommendation[]
  auditLogs             UserAuditLog[]
  sosAlerts             SOSAlert[]
  organization        Organization?          @relation(fields: [organizationId], references: [id])
  sportProfile        SportProfile?          @relation(fields: [sportProfileId], references: [id])
  usageRecords        OrganizationUsageRecord[]

  // Closes P13: every list query filters on deletedAt; without
  // an index the planner may scan. The tournaments list also
  // filters on status; the publicSlug is already @unique.
  @@index([deletedAt])
  @@index([status])
  @@index([organizationId, eventSlug])
  @@index([portalPublished])
  @@unique([organizationId, eventSlug])
}

// Competitor-Tournament registration link
model Registration {
  id                   String    @id @default(uuid())
  tournamentId         String
  competitorId         String
  patterns             Boolean   @default(false)
  sparring             Boolean   @default(false)
  weightAtRegistration Float? // Weight at time of registration
  ageAtTournament      Int? // Calculated age at tournament date
  checkedIn            Boolean   @default(false)
  checkInTime          DateTime?
  checkInWeight        Float? // Weight at check-in (for verification)
  parentName           String?
  parentEmail          String?
  parentPhone          String?
  managementTokenHash String?   @unique
  managementTokenExpiresAt DateTime? // Token expires 30 days after generation
  managementTokenRevokedAt DateTime? // Director revoked; old token no longer valid
  consentVersion       String?
  consentAcceptedAt    DateTime?
  privacyAccepted      Boolean   @default(false)
  rulesAccepted        Boolean   @default(false)
  guardianAttested     Boolean   @default(false)
  // P2-14: COPPA parental consent verification status
  parentEmailVerified  Boolean   @default(false) // True after parent clicks verification link
  parentEmailVerifiedAt DateTime? // When parent email was verified
  createdAt            DateTime  @default(now())

  // Enhanced attributes for fair matching
  heightAtRegistration Float? // Height at registration time
  reachAtRegistration  Float? // Reach at registration time
  experienceScore      Float? // Calculated from history
  skillEstimate        Float? // Estimated skill level
  competeWithOlder     Boolean @default(false) // Competitor/parent opt-in to compete in older age band
  specialNeeds         String? // Per-registration notes (separate from competitor-level field)
  manualDivisionId     String? // Manager override — pin to a specific Division ID
  seeding              Int? // Manual seeding 1..N (null = auto-seed by rating)

  // Waitlist support (P2-1)
  waitlistStatus     String?   @default("active") // active, waitlisted, promoted, withdrawn
  waitlistPosition   Int? // Position in waitlist (null if not waitlisted)
  waitlistPromotedAt DateTime? // When promoted from waitlist to active

  // P2-2: Payment at registration
  paymentStatus      String?   @default("not_required") // not_required, pending, paid, waived, failed
  paymentIntentId    String? // Stripe PaymentIntent or Checkout Session ID
  paymentAmountCents Int? // Amount paid in cents (stored for audit; truth is Stripe)
  paymentReceivedAt  DateTime? // When payment was confirmed via webhook

  tournament  Tournament           @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  competitor  Competitor           @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  assignments DivisionAssignment[]
  matches1    Match[]              @relation("Competitor1")
  matches2    Match[]              @relation("Competitor2")

  @@unique([tournamentId, competitorId])
  @@index([tournamentId])
  @@index([competitorId])
  @@index([waitlistStatus])
}

// Parental consent verification (P2-14: COPPA compliance)
model ParentalConsentVerification {
  id             String   @id @default(uuid())
  registrationId String
  parentEmail    String
  token          String   @unique
  code           String // 6-digit code
  expiresAt      DateTime // 48-hour TTL
  verifiedAt     DateTime?
  createdAt      DateTime @default(now())

  @@index([registrationId])
  @@index([token])
  @@index([expiresAt])
}

// Division
model Division {
  id           String    @id @default(uuid())
  tournamentId String
  name         String
  gender       String
  beltLevel    String // BB or CB
  beltColor    String? // for CB: White, Yellow, Green, Blue, Red
  danRank      Int? // for BB: 1-6
  ageMin       Int
  ageMax       Int
  weightMin    Float?
  weightMax    Float?
  eventType    String // patterns or sparring
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tournament  Tournament           @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  assignments DivisionAssignment[]
  brackets    Bracket[]

  @@index([tournamentId])
  @@index([deletedAt])
}

// Division assignment
model DivisionAssignment {
  id             String   @id @default(uuid())
  divisionId     String
  registrationId String
  seed           Int? // 1-N for manual seeding
  createdAt      DateTime @default(now())

  division     Division     @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([divisionId, registrationId])
  @@index([divisionId])
  @@index([registrationId])
}

// Bracket
model Bracket {
  id         String   @id @default(uuid())
  divisionId String   @unique
  structure  String // JSON-encoded bracket tree
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  division Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  matches  Match[]
}

// Match
model Match {
  id           String    @id @default(uuid())
  bracketId    String
  matchNumber  Int
  roundName    String? // Winners Round 1, Losers Round 2, Grand Finals, etc.
  competitor1Id String?
  competitor2Id String?
  winnerId     String?
  status       String    @default("pending") // pending, ready, in_progress, completed
  scores       String? // JSON
  ring         String? // Ring assignment (A, B, C, etc.)
  scheduledAt  DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  videoUrl     String? // P2-9: Video review integration

  bracket     Bracket       @relation(fields: [bracketId], references: [id], onDelete: Cascade)
  competitor1 Registration? @relation("Competitor1", fields: [competitor1Id], references: [id], onDelete: SetNull)
  competitor2 Registration? @relation("Competitor2", fields: [competitor2Id], references: [id], onDelete: SetNull)
  auditLog    MatchAuditLog[]

  @@index([bracketId])
  @@index([status])
  @@index([competitor1Id])
  @@index([competitor2Id])
}

// Weight class (per-tournament overrides)
model WeightClass {
  id           String @id @default(uuid())
  tournamentId String
  division     String // CB or BB
  gender       String // M or F
  ageMin       Int
  ageMax       Int
  name         String // Fin, Fly, Bantam, Feather, Light, Welter, Middle, Heavy
  maxWeight    Float

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
}

// User
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  firstName String
  lastName  String
  role      String   @default("viewer") // admin, director, scorekeeper, viewer
  tokenVersion Int    @default(0) // P0-1: JWT token version for invalidation
  isActive  Boolean  @default(true) // P0-2: Account status (disabled accounts cannot log in)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationMemberships OrganizationMember[]
  tournamentAccess        UserTournamentAccess[]
  auditLogs               UserAuditLog[]

  @@index([email])
  @@index([role])
}

// User-Tournament access control
model UserTournamentAccess {
  id           String   @id @default(uuid())
  userId       String
  tournamentId String
  role         String // director, scorekeeper, viewer
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([userId, tournamentId])
  @@index([userId])
  @@index([tournamentId])
}

// Magic link authentication
model MagicLink {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  code      String // 6-digit code for manual entry
  expiresAt DateTime
  createdAt DateTime @default(now())
  invalidatedAt DateTime? // Brute-force protection: invalidate after N wrong tries

  @@index([email])
  @@index([expiresAt])
}

// Tournament rules
model TournamentRule {
  id           String   @id @default(uuid())
  tournamentId String
  key          String
  value        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, key])
  @@index([tournamentId])
}

// Competitor historical performance tracking (P2-13)
model CompetitorHistory {
  id           String   @id @default(uuid())
  competitorId String
  tournamentId String
  eventType    String // patterns or sparring
  placement    Int? // 1, 2, 3, 4, or null (did not place)
  matchesWon   Int      @default(0)
  matchesLost  Int      @default(0)
  totalPoints  Int      @default(0)
  createdAt    DateTime @default(now())

  competitor Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([competitorId])
  @@index([tournamentId])
}

// Competitor skill rating (for fair matching and seeding)
model CompetitorRating {
  id           String   @id @default(uuid())
  competitorId String
  eventType    String // patterns or sparring
  rating       Float    @default(1000) // Elo-style rating
  confidence   Float    @default(0) // 0-1, increases with more matches
  lastMatchAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  competitor Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([competitorId, eventType])
  @@index([competitorId])
}

// Matchup history (P2-10: Avoid repeat matchups in same division)
model MatchupHistory {
  id            String   @id @default(uuid())
  tournamentId  String
  competitor1Id String
  competitor2Id String
  eventType     String // patterns or sparring
  matchedAt     DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId, competitor1Id])
  @@index([tournamentId, competitor2Id])
  @@index([tournamentId, eventType])
}

// Public display heartbeat (P1-12: Track public scoreboard viewer activity)
model PublicDisplayHeartbeat {
  tournamentId    String   @id
  lastHeartbeatAt DateTime @default(now())
  activeViewers   Int      @default(1)

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
}

// Tournament operation audit trail (P1-2: Audit key mutations for security)
model TournamentOperationAudit {
  id           String   @id @default(uuid())
  tournamentId String
  userId       String?
  operation    String // create_division, delete_division, generate_bracket, reset_bracket, etc.
  entityType   String? // division, bracket, match, etc.
  entityId     String?
  details      String? // JSON
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId, createdAt])
  @@index([operation])
}

// AI-generated recommendations (P2-10: Smart division splitting, seeding suggestions)
model Recommendation {
  id           String   @id @default(uuid())
  tournamentId String
  type         String // division_split, seeding_adjustment, schedule_optimization, etc.
  targetId     String? // Division ID, Match ID, etc.
  title        String
  description  String
  confidence   Float    @default(0) // 0-1
  status       String   @default("pending") // pending, accepted, rejected, dismissed
  createdAt    DateTime @default(now())
  resolvedAt   DateTime?

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId, status])
  @@index([createdAt])
}

// Director SOS alerts (P2-10: Real-time event day warnings)
model SOSAlert {
  id           String   @id @default(uuid())
  tournamentId String
  severity     String // info, warning, critical
  category     String // delay, injury, equipment, conflict, other
  title        String
  message      String
  source       String? // ring, division, match, etc.
  sourceId     String?
  status       String   @default("active") // active, acknowledged, resolved
  createdAt    DateTime @default(now())
  acknowledgedAt DateTime?
  resolvedAt   DateTime?

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId, status])
  @@index([severity])
  @@index([createdAt])
}

// Invitations for org membership (P1-1)
model Invitation {
  id             String    @id @default(uuid())
  email          String
  firstName      String
  lastName       String
  role           String // director, scorekeeper, viewer
  organizationId String
  token          String    @unique
  status         String    @default("pending") // pending, accepted, expired
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
  @@index([status])
  @@index([organizationId])
}

// Match audit log for undo functionality
model MatchAuditLog {
  id            String   @id @default(uuid())
  matchId       String
  previousState String // JSON snapshot of match state before update
  newState      String // JSON snapshot of match state after update
  userId        String?
  createdAt     DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
}

// Organization (multi-tenant isolation)
model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  plan      String   @default("free") // free, starter, pro, enterprise
  settings  String? // JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Organization-level branding (inherited by tournaments unless overridden)
  brandName         String? // Display name for public pages
  brandPrimaryColor String? @default("#DC2626") // Hex color code
  brandLogoUrl      String? // Public URL to org logo

  members     OrganizationMember[]
  tournaments Tournament[]
  supportTickets SupportTicket[]
  billingSubscription OrganizationBillingSubscription?
  planChanges         OrganizationPlanChange[]
  invitations         Invitation[]
  auditLogs           UserAuditLog[]
  usageRecords        OrganizationUsageRecord[]
  tournamentTemplates TournamentTemplate[]
  customDomains       CustomDomain[]

  @@index([slug])
}

model OrganizationBillingSubscription {
  id                     String    @id @default(uuid())
  organizationId         String    @unique
  provider               String    @default("manual")
  providerCustomerId     String?   @unique
  providerSubscriptionId String?   @unique
  status                 String    @default("inactive")
  plan                   String    @default("free")
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  gracePeriodEndsAt      DateTime?
  paymentFailedAt        DateTime?
  lastPaymentFailureReason String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([plan])
  @@index([gracePeriodEndsAt])
}

model OrganizationPlanChange {
  id             String   @id @default(uuid())
  organizationId String
  fromPlan       String
  toPlan         String
  source         String   @default("manual")
  reason         String
  changedBy      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model BillingWebhookEvent {
  id              String   @id @default(uuid())
  providerEventId String   @unique
  type            String
  payloadHash     String
  processedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([type])
  @@index([processedAt])
}

model OrganizationUsageRecord {
  id                  String    @id @default(uuid())
  organizationId      String
  tournamentId        String
  competitorCount     Int       @default(0)
  recordedAt          DateTime  @default(now())
  billingPeriodStart  DateTime?
  billingPeriodEnd    DateTime?
  reportedToStripe    Boolean   @default(false)
  reportedAt          DateTime?
  createdAt           DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tournament   Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([tournamentId])
  @@index([recordedAt])
  @@index([reportedToStripe])
}

// Organization membership
model OrganizationMember {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  role           String   @default("member") // owner, admin, member
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

// User audit log for security tracking (P1-3)
model UserAuditLog {
  id             String   @id @default(uuid())
  userId         String
  action         String // login, logout, role_change, org_invite_sent, org_invite_accepted, tournament_created, tournament_deleted, etc.
  details        String? // JSON with contextual info (e.g., {oldRole, newRole}, {tournamentId, tournamentName}, {inviteeEmail})
  ipAddress      String?
  userAgent      String?
  organizationId String?
  tournamentId   String?
  createdAt      DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tournament   Tournament?   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([action])
  @@index([organizationId])
  @@index([tournamentId])
}

// Sport configuration profile
model SportProfile {
  id             String   @id @default(uuid())
  name           String // e.g. "Taekwondo", "Karate", "Judo", "MMA", "Boxing"
  slug           String // e.g. "taekwondo", "karate", "judo", "mma", "boxing"
  icon           String? // emoji
  eventTypes     String // JSON array: [{id, name, hasWeightClasses, description}]
  beltConfig     String // JSON: {levels:[{name,abbreviation,rank,color}], hasStripes, hasDanRank, topLevelName}
  scoringConfig  String // JSON: {type:"points"|"decision"|"time", hasPenalties, penaltyName}
  ageGroupConfig String? // JSON array: [{min,max,label}]
  isGlobal       Boolean  @default(true) // false = org-specific
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tournaments Tournament[]

  @@unique([slug])
}

// Medical/incident tracking
model Incident {
  id             String    @id @default(uuid())
  tournamentId   String
  matchId        String?
  registrationId String?
  type           String // injury, disqualification, medical, equipment, conduct
  severity       String // minor, moderate, serious
  description    String
  actionTaken    String? // first_aid, withdrawn, continued, ambulance
  reportedBy     String? // userId of reporter
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  // Soft-delete: keeps incident reports on file (often required
  // for liability / insurance) without surfacing them in active
  // dashboards. Same pattern as Competitor / Tournament / Division.
  deletedAt      DateTime?

  // Closes B8: orphan incident rows on hard-delete of Tournament.
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@index([matchId])
  @@index([registrationId])
  @@index([deletedAt])
}

// Customer support requests created from app chat and marketing leads.
// Supports both authenticated users and anonymous users that provide
// a contact name/email in the support widget.
model SupportTicket {
  id                 String   @id @default(uuid())
  source             String // web-chat, support-widget, api
  status             String   @default("open") // open | in_progress | resolved | closed
  priority           String   @default("normal") // low | normal | high
  subject            String
  requestedByEmail   String?
  requestedByName    String?
  page               String?
  lastUserMessage    String
  lastAssistantMessage String?
  conversation       String // JSON array: [{role:'user'|'assistant',content:string,at:string}]
  notes              String?
  resolvedAt         DateTime?
  userId             String?
  organizationId     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([requestedByEmail])
  @@index([userId])
  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([createdAt])
}

// Division backup/restore (in-DB backup store, Phase 6, P15)
// Replaces the previous single-file /tmp/tournament-backups/
// BACKUP_DIR/<tournamentId>.json store (closes day-2 follow-up:
// move backupStore to DB table). One row per tournament, overwritten
// in place — there's no audit history, just the "last known good"
// snapshot. The delete-on-success / restore-on-failure lifecycle
// lives in src/server/services/backup-recovery.ts.
model BackupState {
  tournamentId String   @id
  // JSON-encoded TournamentBackup (see backup-recovery.ts). The
  // service layer parses this on read; the schema doesn't try to
  // shape the contents because the structure evolves with the
  // division / assignment models. ~10 KB per row.
  payload      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Organization-scoped tournament templates
// Allows directors to create reusable tournament setup templates
// capturing settings, rules, weight classes, sport defaults.
// Templates are cloned into new tournaments via POST /api/tournaments/from-template/:id
model TournamentTemplate {
  id             String   @id @default(uuid())
  organizationId String
  name           String // e.g. "Spring Sparring Championship Template"
  description    String? // Optional notes for directors
  
  // Tournament setup fields (cloned into new tournament)
  sportProfileSlug String  @default("taekwondo")
  settings         String? // JSON - tournament settings (division threshold, age groups, etc.)
  rules            String? // JSON - tournament rules
  weightClasses    String? // JSON - array of weight class definitions
  
  // Branding defaults (optional overrides of org-level branding)
  brandName         String?
  brandPrimaryColor String?
  brandLogoUrl      String?
  
  // Soft-delete: keep templates for audit/restore
  deletedAt DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? // User ID who created the template

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, deletedAt])
}

// Custom domain configuration for organizer-branded public portals
// Enables organizations to serve public registration/scoreboard pages on their own domain
model CustomDomain {
  id             String    @id @default(uuid())
  organizationId String
  
  // Domain configuration
  hostname       String    @unique // e.g., "register.myclub.com" (normalized to lowercase)
  
  // Verification method and state
  verificationMethod String  @default("txt") // "txt" or "cname"
  verificationToken  String  // Random token for TXT record or CNAME target subdomain
  verifiedAt         DateTime? // When DNS verification succeeded
  
  // Lifecycle status
  status         String    @default("pending") // pending, verified, active, disabled, revoked
  activatedAt    DateTime? // When domain was activated (first served traffic)
  disabledAt     DateTime? // When domain was disabled (soft-disable, can be re-enabled)
  revokedAt      DateTime? // When domain was permanently revoked (cannot be reactivated)
  revokedReason  String?   // Why it was revoked (abuse, migration, user request)
  
  // Audit trail
  createdBy      String?   // User ID who attached the domain
  verifiedBy     String?   // User ID who triggered verification
  activatedBy    String?   // User ID who activated
  revokedBy      String?   // User ID who revoked
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([hostname]) // Already unique, but useful for lookups by status+hostname
}
