# =====================================================================
# bowin (TKD Tournament Manager) — environment configuration
# =====================================================================
# Closes D6 from the 2026-07-15 review: .env.example used to list
# only 5 of the 17 env vars the code reads. New operators following
# the README had no way to know which keys to set, and a missing
# MAILGUN_API_KEY silently degraded auth into dev-mode (auto-creates
# viewer accounts, returns magic links in JSON). Every var the code
# reads is documented below with the gate it controls.
# =====================================================================

# --- Required in every environment ---

# Database Configuration. Coolify links a Postgres service and injects
# this automatically in the deploy; for local dev, point at any
# reachable Postgres. Format: postgresql://USER:PASS@HOST:PORT/DBNAME
DATABASE_URL=postgresql://taekwondo:taekwondo@localhost:5432/taekwondo_tournament

# Server port. Dev default: 3001 (src/server/index.ts: `PORT || 3001`).
# The Vite dev proxy maps /api -> localhost:3001 in local dev.
PORT=3001

# JWT signing secret. Generate with: openssl rand -base64 48
# The auth middleware enforces 32+ chars in production; the dev
# default below is intentionally weak — DO NOT SHIP TO PROD.
JWT_SECRET=replace-me-with-a-real-secret-from-openssl-rand-base64-48

# Node environment. The deploy script always sets this to "production"
# on the live box; the auth dev-mode gates (S1, S2, S3, D5) all key
# off this string. Setting it to anything other than "production" in
# a live deploy is an explicit opt-in to dev-mode behavior.
NODE_ENV=development

# --- CORS / setup (optional) ---

# Admin Setup Key. Required for POST /api/auth/setup (S3) and
# POST /api/auth/setup-admin. Generate with: openssl rand -hex 32
# The handler returns 503 (not 401) if this is missing, so a
# fresh deploy without it fails loudly instead of accepting any
# unauthenticated admin creation.
ADMIN_SETUP_KEY=

# Allowed Origins (CORS) — comma-separated. In production this
# must be set; if absent, the CORS handler fails closed (rejects
# all cross-origin requests). Example:
#   ALLOWED_ORIGINS=https://tkd.ashbi.ca,https://bowin.app
ALLOWED_ORIGINS=

# --- Email (Mailgun). Without MAILGUN_API_KEY the magic-link auth
# path degrades to dev-mode — auto-creates viewer accounts for any
# email typed, and (with ENABLE_E2E_AUTH_BYPASS=1) returns the
# token in the JSON response. Set these in every live deploy.

# Mailgun API key. Get from the Mailgun dashboard. Required for
# production magic-link delivery.
MAILGUN_API_KEY=

# Mailgun verified sending domain. Must be a domain you've added
# to Mailgun and verified the SPF/DKIM records for. Default in
# code: "ashbi.ca" — override per deploy.
MAILGUN_DOMAIN=ashbi.ca

# Mailgun API base URL. Override only if you use the EU region.
MAILGUN_BASE_URL=https://api.mailgun.net/v3

# From: header on outgoing email. The address must be @MAILGUN_DOMAIN.
EMAIL_FROM_ADDRESS=noreply@ashbi.ca

# From: header display name. Keep short — it appears in the
# recipient's inbox. The brand kit recommends "bowin".
EMAIL_FROM_NAME=bowin
SUPPORT_ALERT_EMAIL=

# Optional AI fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Public URL ---

# Base URL the magic-link emails link back to. Used by the verify
# page to construct the public-facing link. Must be the
# https origin the user is on (Caddy terminates TLS). Defaults
# to ALLOWED_ORIGINS[0] then http://localhost:5173.
PUBLIC_APP_URL=

# Strong bearer token for the private Prometheus-compatible metrics endpoint
# at /api/internal/metrics. Required in production; generate 32+ random chars.
METRICS_TOKEN=

# --- Stripe subscriptions (optional for a manually invoiced pilot) ---
# Configure all four together to enable self-service checkout, signed
# subscription webhooks, and the customer billing portal. Keep live keys only
# in the deployment secret store. The webhook endpoint is /api/billing/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# --- Dev / demo gates. EVERY ONE OF THESE defaults to OFF.
# Setting them in production is a deliberate opt-in. The
# review that drove these defaults is in docs/REVIEW-2026-07-15.md.

# Enable /api/auth/dev-token (admin login without email). When
# true, the endpoint also requires NODE_ENV=development, so this
# is doubly-gated. Off in every deploy. (S1)
ENABLE_DEV_AUTH=

# Enable /api/auth/setup. Required to create the first admin
# user on a fresh DB. The endpoint also requires the matching
# ADMIN_SETUP_KEY value to be supplied in the request body.
# (S3)
# (no separate env var — gated by ADMIN_SETUP_KEY above)

# Enable the /api/auth/demo admin-as-guest login. Off in every
# production deploy unless you have a specific need (e.g. public
# demo at tkd.ashbi.ca). (S2)
ENABLE_DEMO_LOGIN=

# Required alongside ENABLE_DEMO_LOGIN in production. Set to 1 only for a
# dedicated database containing fabricated demo data, never customer data.
DEMO_ISOLATED_DATA=

# Independent public demo-login allowance per IP per 15 minutes.
DEMO_RATE_LIMIT_MAX=30

# One-time operator attestation for the destructive showcase reset command.
# Supply only to that command; do not persist it in the application env.
DEMO_RESET_CONFIRM=

# Ed25519 DER keys used to issue and verify short-lived offline venue identity
# capabilities. Generate a unique pair per environment. Keep the PKCS8 private
# key server-only; the SPKI public key is intentionally embedded at build time.
OFFLINE_CAPABILITY_PRIVATE_KEY_BASE64=
VITE_OFFLINE_CAPABILITY_PUBLIC_KEY_BASE64=

# Auto-create dev users when magic-link is requested for an
# unknown email. The dev-mode path is doubly-gated on
# NODE_ENV !== 'production'. Off by default; turn on for local
# testing.
ENABLE_DEV_AUTH=

# E2E test bypass: when set, /api/auth/request-magic-link includes
# the magicUrl + 6-digit code in the response JSON so the
# Playwright suite can read them. Off by default. NEVER set
# in production. (S25, D5)
ENABLE_E2E_AUTH_BYPASS=

# Disable all express-rate-limit guards. For load-testing only.
# Off in every deploy.
RATE_LIMIT_DISABLED=

# --- Debug ---

# Verbose bracket advancement logs. Off in production.
DEBUG=

