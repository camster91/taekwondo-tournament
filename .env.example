# Database Configuration (provided by Coolify from linked Postgres service)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://taekwondo:taekwondo@taekwondo-db:5432/taekwondo_tournament

# JWT Secret (generate a strong random string for production)
# Example: openssl rand -base64 48
JWT_SECRET=your-j...e-me

# Admin Setup Key (optional)
ADMIN_SETUP_KEY=

# Allowed Origins (CORS) - comma-separated
# Example: https://tournament.yourdomain.com,https://tournament-staging.yourdomain.com
ALLOWED_ORIGINS=
